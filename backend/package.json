{
  "name": "geoguide-backend",
  "version": "1.0.0",
  "private": true,
  "description": "GeoGuide three-database integration backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "enrich:names": "node src/scripts/enrichNames.js",
    "enrich:names:dry": "node src/scripts/enrichNames.js --dry-run",
    "enrich:names:fast": "node src/scripts/enrichNames.js --skip-nominatim",
    "enrich:names:limit": "node src/scripts/enrichNames.js --limit=50",
    "sync:names": "node src/scripts/syncMongoNames.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.12.1",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
